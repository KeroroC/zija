# ===== 数据库 =====
# Docker Compose postgres 容器使用的库名 / 用户 / 密码
ZIJA_POSTGRES_DB=zija
ZIJA_POSTGRES_USER=zija
ZIJA_POSTGRES_PASSWORD=change-this-password
# Spring Boot 数据源（本地开发连 localhost；Compose 部署内应为 postgres:5432）
ZIJA_DB_URL=jdbc:postgresql://localhost:5432/zija
ZIJA_DB_USERNAME=zija
ZIJA_DB_PASSWORD=change-this-password

# ===== 运行模式 =====
# 版本号，显示在系统信息页
ZIJA_VERSION=dev
# 生产环境设为 prod：强制关闭 Swagger；Secure Cookie 由 TLS 传输层（X-Forwarded-Proto）自动决定
ZIJA_PROFILES_ACTIVE=
# 是否启用 Swagger UI（prod profile 下无论此值如何均强制关闭）
ZIJA_SWAGGER_ENABLED=false

# ===== 端口与存储 =====
# 宿主机暴露的 HTTP 端口（供反代转发目标）
ZIJA_HTTP_PORT=8088
# 宿主机暴露的 PostgreSQL 端口（仅本地访问时可省略）
ZIJA_POSTGRES_PORT=5432
# 文件存储根目录（Compose 容器内路径；本地开发可用 ./files）
ZIJA_FILE_STORAGE_PATH=/var/lib/zija/files
# 附件回收站保留期（天）：保留期满后由清除任务物理删除
ZIJA_FILE_RETENTION_DAYS=30
# 备份产物根目录（宿主机路径）
ZIJA_BACKUP_DIR=./backups

# ===== AI（本地 Ollama，可选）=====
# 未启动 Ollama 时核心业务仍可用；准备 AI 前请在 Ollama 中拉取对应模型。
ZIJA_AI_OLLAMA_BASE_URL=http://localhost:11434
ZIJA_AI_CHAT_MODEL=qwen2.5:7b
ZIJA_AI_EMBEDDING_MODEL=nomic-embed-text:latest

# ===== 登录限流 =====
# 同一账号在窗口内的最大失败尝试次数
ZIJA_RATE_LIMIT_ACCOUNT_THRESHOLD=5
ZIJA_RATE_LIMIT_ACCOUNT_WINDOW_MINUTES=5
# 同一 IP 在窗口内的最大失败尝试次数
ZIJA_RATE_LIMIT_IP_THRESHOLD=50
ZIJA_RATE_LIMIT_IP_WINDOW_MINUTES=5
# 限流内存表最大条目数
ZIJA_RATE_LIMIT_MAX_ENTRIES=1000

# ===== 后台定时任务 =====
# 时区（提醒与临期扫描按此时区计算"今日"，日期边界逻辑依赖它）
ZIJA_SCHEDULE_ZONE=Asia/Shanghai
# 每日临期扫描 cron
ZIJA_SCHEDULE_EXPIRY_SCAN="0 0 3 * * *"
# 每日邮件摘要 cron
ZIJA_SCHEDULE_MAIL_DIGEST="0 30 3 * * *"
# 事件死信重投 cron
ZIJA_SCHEDULE_DEAD_LETTER_RETRY="*/30 * * * * *"
# 报表死信重投 cron
ZIJA_SCHEDULE_REPORTING_DLQ_RETRY="*/30 * * * * *"
# 附件回收站保留期清除 cron
ZIJA_SCHEDULE_FILE_PURGE="0 20 3 * * *"

# ===== SMTP 邮件（可选，不配置则邮件功能静默禁用）=====
ZIJA_SMTP_HOST=
ZIJA_SMTP_PORT=587
ZIJA_SMTP_USERNAME=
ZIJA_SMTP_PASSWORD=
ZIJA_SMTP_FROM=
ZIJA_SMTP_TLS=true
