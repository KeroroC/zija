  "components": {
    "schemas": {
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "ACTIVE|DEACTIVATED"
          }
        },
        "required": [
          "status"
        ]
      },
      "UpdateRoleRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "ADMIN|MEMBER"
          }
        },
        "required": [
          "role"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": [
          "newPassword",
          "token"
        ]
      },
      "InspectRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "token"
        ]
      },
      "InspectResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "ownerDisplayName": {
            "type": "string"
          }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "ADMIN|MEMBER"
          },
          "expiresInHours": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "role"
        ]
      },
      "InvitationInfoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "RedeemRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          },
          "displayName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "displayName",
          "password",
          "token",
          "username"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "TransferOwnershipRequest": {
        "type": "object",
        "properties": {
          "targetMemberId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "targetMemberId"
        ]
      },
      "BootstrapRequest": {
        "type": "object",
        "properties": {
          "householdName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          },
          "displayName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "displayName",
          "householdName",
          "password",
          "username"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "SystemInfoResponse": {
        "type": "object",
        "properties": {
          "application": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "installationId": {
            "type": "string",
            "format": "uuid"
          },
          "databaseTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "HouseholdStatusResponse": {
        "type": "object",
        "properties": {
          "initialized": {
            "type": "boolean"
          }
        }
      },
      "CurrentMemberResponse": {
        "type": "object",
        "properties": {
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "memberId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CsrfToken": {
        "type": "object",
        "properties": {
          "parameterName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      }
